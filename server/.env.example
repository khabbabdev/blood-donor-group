# ===========================================
# REQUIRED (Vercel-এ অবশ্যই দিতে হবে)
# ===========================================
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/blood-donor-group
JWT_SECRET=generate-a-32-char-random-string-here
JWT_EXPIRE=30d
CLIENT_URL=https://your-app.vercel.app

# ===========================================
# EMAIL / SMTP (Password reset-এর জন্য প্রয়োজন)
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
FROM_NAME=Blood Donor Group
ADMIN_EMAIL=admin@yourdomain.com

# ===========================================
# OPTIONAL (Cloudinary - avatar uploadের জন্য)
# না দিলে base64 fallback হবে
# ===========================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===========================================
# LOCAL DEVELOPMENT ONLY
# ===========================================
NODE_ENV=development
PORT=5000

# ===========================================
# AUTO-SET BY VERCEL (আপনি দিবেন না)
# ===========================================
# NODE_ENV=production
# VERCEL=1
# PORT=<auto-assigned by Vercel>

# ===========================================
# QUICK TIPS
# ===========================================
# JWT_SECRET জেনারেট করতে: openssl rand -base64 32
# Gmail SMTP ব্যবহার করলে: App Password ব্যবহার করুন (নরমাল পাসওয়ার্ড নয়)
# MongoDB Atlas-এ Network Access: 0.0.0.0/0 (Allow from anywhere) দিন
# Vercel-এ Environment Variables সেট করার পর Redeploy করুন