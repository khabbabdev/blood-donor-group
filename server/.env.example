NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/blood-donor-group
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_NAME=Blood Donor Group
CLIENT_URL=http://localhost:5173
ADMIN_EMAIL=your_admin_email@gmail.com

# Production (Vercel) Environment Variables
# Set these in Vercel Project Settings > Environment Variables
# NODE_ENV=production
# PORT=<auto-assigned by Vercel>
# MONGODB_URI=<your MongoDB Atlas connection string>
# JWT_SECRET=<your secure JWT secret>
# CLIENT_URL=<your Vercel deployment URL>
# ADMIN_EMAIL=<your admin notification email>
# CLOUDINARY_*=<your Cloudinary credentials>
# SMTP_*=<your SMTP credentials>
